---
import Layout from '../layouts/Layout.astro';
import SeznamAktualit from '../components/SeznamAktualit.astro';
import SeznamUdalosti from '../components/SeznamUdalosti.astro';
import ObnovaPrispevku from '../components/ObnovaPrispevku.astro';
import { svj, klientskaSekce } from '../nastaveni';
import { nacistPriSestaveni } from '../prispevky';
import { url, tel } from '../utils';

// Kolik aktualit a událostí zobrazit na úvodní stránce
const POCET_AKTUALIT = 6;
const POCET_UDALOSTI = 4;

// Příspěvky z klientské sekce (při sestavení webu; v prohlížeči se pak obnoví)
const prispevky = (await nacistPriSestaveni(klientskaSekce)) ?? [];
---

<Layout titulek="Úvod">
  <section class="hero">
    <h1>Vítejte na webu {svj.kratkyNazev}</h1>
    <p>Aktuální informace z domu, kontakty na výbor, dokumenty ke stažení a hlášení závad na jednom místě.</p>
    <div class="hero__akce">
      <a class="tlacitko" href={url('zavady/')}>Nahlásit závadu</a>
      <a class="tlacitko tlacitko--obrys" href={url('dokumenty/')}>Dokumenty</a>
    </div>
  </section>

  <div class="havarie">
    <span><strong>Havárie</strong> (voda, plyn, elektřina) – volejte ihned:</span>
    <a href={`tel:${tel(svj.havarijniTelefon)}`}>{svj.havarijniTelefon}</a>
  </div>

  <SeznamUdalosti prispevky={prispevky} limit={POCET_UDALOSTI}>
    <h2>Plánované události</h2>
  </SeznamUdalosti>

  <SeznamAktualit prispevky={prispevky} limit={POCET_AKTUALIT} odkazNaVse>
    <h2>Aktuality</h2>
  </SeznamAktualit>

  <ObnovaPrispevku />
</Layout>
